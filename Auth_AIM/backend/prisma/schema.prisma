// TECHZONE CLOUD — TEAM 1 PRISMA SCHEMA
// Domains: Auth + IAM + Context, Tenant / Subscription / Billing, Platform Administration
// Backend: NestJS | ORM: Prisma | Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
  ARCHIVED
}
enum IdentityType {
  HUMAN
  SERVICE_ACCOUNT
  APPLICATION
  DEVICE
  SYSTEM
  EXTERNAL_IDENTITY
  API_CLIENT
  AUTOMATION
  AGENT
}
enum IdentityStatus {
  PENDING
  VERIFIED
  ACTIVE
  SUSPENDED
  ARCHIVED
}
enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  ARCHIVED
}
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}
enum SiteStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}
enum MembershipStatus {
  INVITED
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}
enum GroupType {
  SYSTEM
  STATIC
  DYNAMIC
}
enum RoleStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}
enum PolicyEffect {
  ALLOW
  DENY
  STEP_UP
  APPROVAL_REQUIRED
}
enum PolicyStatus {
  DRAFT
  ACTIVE
  DISABLED
  SUPERSEDED
  ARCHIVED
}
enum AuthorizationResult {
  ALLOW
  DENY
  STEP_UP_REQUIRED
  APPROVAL_REQUIRED
}
enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}
enum TokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
  REUSED
}
enum CredentialType {
  PASSWORD
  PASSKEY
  API_KEY
  EXTERNAL
  RECOVERY
}
enum CredentialStatus {
  ACTIVE
  DISABLED
  REVOKED
  EXPIRED
}
enum MfaType {
  TOTP
  EMAIL_OTP
  SMS_OTP
  PASSKEY
}
enum DeviceTrustLevel {
  UNKNOWN
  UNTRUSTED
  TRUSTED
  PRIVILEGED
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum Environment {
  DEVELOPMENT
  TEST
  STAGING
  PRODUCTION
}
enum ServiceAccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  ARCHIVED
}
enum SecuritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum PlanStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}
enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMESTER
  YEARLY
  CUSTOM
}
enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  PARTIALLY_PAID
  OVERDUE
  VOID
  CANCELLED
}
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum EntitlementValueType {
  BOOLEAN
  INTEGER
  DECIMAL
  STRING
  JSON
}
enum AdminActionStatus {
  REQUESTED
  PENDING_APPROVAL
  APPROVED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
enum DiagnosticStatus {
  HEALTHY
  DEGRADED
  WARNING
  CRITICAL
  UNAVAILABLE
  UNKNOWN
}
enum PlatformServiceStatus {
  STARTING
  HEALTHY
  DEGRADED
  UNAVAILABLE
  MAINTENANCE
}
enum DelegationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}
model User {
  id String @id @default(uuid())
  username String @unique
  primaryEmail String? @unique
  phone String?
  firstName String?
  lastName String?
  displayName String?
  avatarRef String?
  locale String?
  timezone String?
  status UserStatus @default(PENDING)
  defaultTenantId String?
  metadata Json?
  statusChangedAt DateTime?
  statusChangedBy String?
  statusChangedReason String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?
  version Int @default(1)

  defaultTenant Tenant? @relation("DefaultTenantUsers", fields: [defaultTenantId], references: [id])
  identities UserIdentity[]
  memberships Membership[]
  groupMembers GroupMember[]
  roleAssignments RoleAssignment[]
  credentials Credential[]
  passwordHistory PasswordHistory[]
  sessions Session[]
  mfaMethods MfaMethod[]
  recoveryCodes RecoveryCode[]
  devices Device[]

  @@index([status])
  @@index([primaryEmail])
  @@index([phone])
  @@index([defaultTenantId])
}

model Identity {
  id String @id @default(uuid())
  type IdentityType
  status IdentityStatus @default(PENDING)
  provider String?
  subject String?
  email String?
  phone String?
  confidence Float?
  verifiedAt DateTime?
  metadata Json?
  statusChangedAt DateTime?
  statusChangedBy String?
  statusChangedReason String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?
  version Int @default(1)

  userLinks UserIdentity[]
  externalLinks ExternalIdentityLink[]
  serviceAccount ServiceAccount?

  @@unique([provider, subject])
  @@index([type])
  @@index([status])
  @@index([email])
  @@index([phone])
}

model UserIdentity {
  id String @id @default(uuid())
  userId String
  identityId String
  isPrimary Boolean @default(false)
  linkedAt DateTime @default(now())
  linkedBy String?
  unlinkedAt DateTime?
  unlinkedBy String?
  user User @relation(fields: [userId], references: [id])
  identity Identity @relation(fields: [identityId], references: [id])

  @@unique([userId, identityId])
  @@index([userId])
  @@index([identityId])
}

model ExternalIdentityLink {
  id String @id @default(uuid())
  identityId String
  providerType String
  providerInstanceId String
  externalSubjectId String
  externalEntityType String?
  confidence Float?
  verified Boolean @default(false)
  verifiedAt DateTime?
  lastSyncAt DateTime?
  disabledAt DateTime?
  metadata Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  identity Identity @relation(fields: [identityId], references: [id])

  @@unique([providerType, providerInstanceId, externalSubjectId])
  @@index([identityId])
}

model Tenant {
  id String @id @default(uuid())
  code String @unique
  name String
  description String?
  status TenantStatus @default(PENDING)
  locale String?
  timezone String?
  metadata Json?
  statusChangedAt DateTime?
  statusChangedBy String?
  statusChangedReason String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?
  version Int @default(1)

  defaultUsers User[] @relation("DefaultTenantUsers")
  organizations Organization[]
  memberships Membership[]
  groups Group[]
  roles Role[]
  policies AccessPolicy[]
  serviceAccounts ServiceAccount[]
  subscriptions Subscription[]
  invoices Invoice[]
  delegations AdminDelegation[]

  @@index([status])
}

model Organization {
  id String @id @default(uuid())
  tenantId String
  code String
  name String
  description String?
  status OrganizationStatus @default(ACTIVE)
  metadata Json?
  statusChangedAt DateTime?
  statusChangedBy String?
  statusChangedReason String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?
  version Int @default(1)
  tenant Tenant @relation(fields: [tenantId], references: [id])
  sites Site[]
  memberships Membership[]
  groups Group[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
}

model Site {
  id String @id @default(uuid())
  organizationId String
  code String
  name String
  description String?
  status SiteStatus @default(ACTIVE)
  metadata Json?
  statusChangedAt DateTime?
  statusChangedBy String?
  statusChangedReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  version Int @default(1)
  organization Organization @relation(fields: [organizationId], references: [id])
  memberships Membership[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

model Membership {
  id String @id @default(uuid())
  userId String
  tenantId String
  organizationId String?
  siteId String?
  status MembershipStatus @default(INVITED)
  validFrom DateTime?
  validUntil DateTime?
  joinedAt DateTime?
  revokedAt DateTime?
  revokedBy String?
  revokeReason String?
  metadata Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  version Int @default(1)

  user User @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  site Site? @relation(fields: [siteId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([siteId])
  @@index([status])
  @@index([tenantId, status])
}

model Group {
  id String @id @default(uuid())
  tenantId String
  organizationId String?
  code String
  name String
  description String?
  type GroupType @default(STATIC)
  dynamicRule Json?
  active Boolean @default(true)
  metadata Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?
  version Int @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  members GroupMember[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([organizationId])
}

model GroupMember {
  id String @id @default(uuid())
  groupId String
  userId String
  validFrom DateTime?
  validUntil DateTime?
  createdAt DateTime @default(now())
  createdBy String?
  removedAt DateTime?
  removedBy String?
  group Group @relation(fields: [groupId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Permission {
  id String @id @default(uuid())
  code String @unique
  resource String
  action String
  name String
  description String?
  critical Boolean @default(false)
  active Boolean @default(true)
  metadata Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  rolePermissions RolePermission[]

  @@index([resource, action])
  @@index([active])
}

model Role {
  id String @id @default(uuid())
  tenantId String?
  code String
  name String
  description String?
  status RoleStatus @default(ACTIVE)
  system Boolean @default(false)
  privileged Boolean @default(false)
  metadata Json?
  statusChangedAt DateTime?
  statusChangedBy String?
  statusChangedReason String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?
  version Int @default(1)

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
}

model RolePermission {
  roleId String
  permissionId String
  grantedAt DateTime @default(now())
  grantedBy String?
  revokedAt DateTime?
  revokedBy String?
  role Role @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RoleAssignment {
  id String @id @default(uuid())
  roleId String
  userId String?
  groupId String?
  serviceAccountId String?
  tenantId String?
  organizationId String?
  siteId String?
  validFrom DateTime?
  validUntil DateTime?
  temporary Boolean @default(false)
  delegated Boolean @default(false)
  assignedBy String?
  createdAt DateTime @default(now())
  revokedAt DateTime?
  revokedBy String?
  revokeReason String?

  role Role @relation(fields: [roleId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  group Group? @relation(fields: [groupId], references: [id])
  serviceAccount ServiceAccount? @relation(fields: [serviceAccountId], references: [id])

  @@index([roleId])
  @@index([userId])
  @@index([groupId])
  @@index([serviceAccountId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([siteId])
}

model AccessPolicy {
  id String @id @default(uuid())
  tenantId String?
  code String
  name String
  description String?
  status PolicyStatus @default(DRAFT)
  effect PolicyEffect
  priority Int @default(100)
  resource String?
  action String?
  subjectType String?
  subjectRef String?
  version Int @default(1)
  effectiveFrom DateTime?
  effectiveUntil DateTime?
  publishedAt DateTime?
  supersededById String?
  metadata Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  conditions PolicyCondition[]

  @@unique([tenantId, code, version])
  @@index([tenantId])
  @@index([status])
  @@index([resource, action])
  @@index([effectiveFrom, effectiveUntil])
}

model PolicyCondition {
  id String @id @default(uuid())
  policyId String
  attribute String
  operator String
  value Json?
  sortOrder Int @default(0)
  metadata Json?
  policy AccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([attribute])
}

model AuthorizationDecision {
  id String @id @default(uuid())
  traceId String
  userId String?
  identityId String?
  tenantId String?
  organizationId String?
  siteId String?
  applicationId String?
  environment Environment?
  resource String
  action String
  result AuthorizationResult
  matchedRoleIds Json?
  matchedPermissionIds Json?
  matchedPolicyIds Json?
  reason Json?
  riskLevel RiskLevel?
  createdAt DateTime @default(now())

  @@index([traceId])
  @@index([userId])
  @@index([tenantId])
  @@index([resource, action])
  @@index([createdAt])
}

model Credential {
  id String @id @default(uuid())
  userId String
  type CredentialType
  status CredentialStatus @default(ACTIVE)
  secretHash String?
  secretRef String?
  identifier String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  expiresAt DateTime?
  revokedAt DateTime?
  revokedBy String?
  revokeReason String?
  lastUsedAt DateTime?
  metadata Json?
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
}

model PasswordHistory {
  id String @id @default(uuid())
  userId String
  passwordHash String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Device {
  id String @id @default(uuid())
  userId String
  fingerprintHash String?
  name String?
  deviceType String?
  trustLevel DeviceTrustLevel @default(UNKNOWN)
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  trustedAt DateTime?
  trustedBy String?
  revokedAt DateTime?
  revokedBy String?
  revokeReason String?
  metadata Json?
  user User @relation(fields: [userId], references: [id])
  sessions Session[]

  @@index([userId])
  @@index([trustLevel])
}

model Session {
  id String @id @default(uuid())
  userId String
  tenantId String?
  organizationId String?
  siteId String?
  applicationId String?
  environment Environment?
  deviceId String?
  status SessionStatus @default(ACTIVE)
  authenticationLevel String?
  riskLevel RiskLevel @default(LOW)
  ipHash String?
  userAgentHash String?
  createdAt DateTime @default(now())
  lastActivityAt DateTime @default(now())
  idleExpiresAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  revokedBy String?
  revokeReason String?
  statusChangedAt DateTime?
  metadata Json?

  user User @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([tenantId])
  @@index([deviceId])
  @@index([status])
  @@index([expiresAt])
  @@index([userId, status])
}

model RefreshToken {
  id String @id @default(uuid())
  sessionId String
  tokenHash String @unique
  familyId String
  status TokenStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  revokeReason String?
  replacedByTokenId String?
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
}

model MfaMethod {
  id String @id @default(uuid())
  userId String
  type MfaType
  label String?
  secretRef String?
  enabled Boolean @default(false)
  verified Boolean @default(false)
  createdAt DateTime @default(now())
  verifiedAt DateTime?
  lastUsedAt DateTime?
  disabledAt DateTime?
  metadata Json?
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([enabled])
}

model RecoveryCode {
  id String @id @default(uuid())
  userId String
  codeHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime?
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ServiceAccount {
  id String @id @default(uuid())
  tenantId String
  identityId String @unique
  code String
  name String
  description String?
  status ServiceAccountStatus @default(ACTIVE)
  metadata Json?
  statusChangedAt DateTime?
  statusChangedBy String?
  statusChangedReason String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?
  version Int @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  identity Identity @relation(fields: [identityId], references: [id])
  credentials ServiceAccountCredential[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
}

model ServiceAccountCredential {
  id String @id @default(uuid())
  serviceAccountId String
  keyId String @unique
  secretHash String?
  secretRef String?
  status CredentialStatus @default(ACTIVE)
  scopes Json?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt DateTime?
  revokedBy String?
  revokeReason String?
  serviceAccount ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([serviceAccountId])
  @@index([status])
}

model SecurityEvent {
  id String @id @default(uuid())
  traceId String?
  type String
  severity SecuritySeverity
  userId String?
  identityId String?
  tenantId String?
  organizationId String?
  siteId String?
  sessionId String?
  deviceId String?
  riskLevel RiskLevel?
  source String?
  metadata Json?
  occurredAt DateTime @default(now())

  @@index([traceId])
  @@index([userId])
  @@index([tenantId])
  @@index([type])
  @@index([severity])
  @@index([occurredAt])
}

model ContextSnapshot {
  id String @id @default(uuid())
  traceId String?
  userId String
  identityId String?
  tenantId String?
  organizationId String?
  siteId String?
  applicationId String?
  environment Environment?
  sessionId String?
  roles Json
  permissions Json
  policies Json?
  authentication Json
  security Json
  subscriptionContext Json?
  entitlementContext Json?
  sourceRevision String?
  resolvedAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([traceId])
  @@index([resolvedAt])
}

model ContextSwitchEvent {
  id String @id @default(uuid())
  traceId String?
  userId String
  sessionId String?
  fromTenantId String?
  fromOrganizationId String?
  fromSiteId String?
  toTenantId String?
  toOrganizationId String?
  toSiteId String?
  previousContextId String?
  resolvedContextId String?
  result String
  reason String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([traceId])
  @@index([createdAt])
}

model ContextInvalidation {
  id String @id @default(uuid())
  subjectType String
  subjectId String
  tenantId String?
  reason String
  revision Int @default(1)
  sourceEventType String?
  sourceEventId String?
  createdAt DateTime @default(now())
  processedAt DateTime?

  @@index([subjectType, subjectId])
  @@index([tenantId])
  @@index([processedAt])
  @@index([createdAt])
}

model AuditEvent {
  id String @id @default(uuid())
  traceId String
  actorId String?
  effectiveIdentityId String?
  effectiveUserId String?
  tenantId String?
  organizationId String?
  siteId String?
  sessionId String?
  action String
  targetType String?
  targetId String?
  result String
  reason String?
  before Json?
  after Json?
  metadata Json?
  previousHash String?
  eventHash String?
  createdAt DateTime @default(now())

  @@index([traceId])
  @@index([actorId])
  @@index([effectiveUserId])
  @@index([tenantId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model OutboxEvent {
  id String @id @default(uuid())
  aggregateType String
  aggregateId String
  eventType String
  payload Json
  traceId String?
  createdAt DateTime @default(now())
  publishedAt DateTime?
  retryCount Int @default(0)
  lastError String?

  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([publishedAt])
  @@index([createdAt])
}

model Plan {
  id String @id @default(uuid())
  code String @unique
  name String
  description String?
  status PlanStatus @default(DRAFT)
  billingInterval BillingInterval @default(MONTHLY)
  price Decimal @db.Decimal(18, 2)
  currency String @default("MGA") @db.VarChar(3)
  trialDays Int?
  metadata Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  archivedAt DateTime?
  version Int @default(1)

  entitlements PlanEntitlement[]
  subscriptions Subscription[]

  @@index([status])
}

model PlanEntitlement {
  id String @id @default(uuid())
  planId String
  featureCode String
  valueType EntitlementValueType @default(BOOLEAN)
  enabled Boolean @default(true)
  integerValue Int?
  decimalValue Decimal? @db.Decimal(18, 4)
  stringValue String?
  jsonValue Json?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@index([featureCode])
}

model Subscription {
  id String @id @default(uuid())
  tenantId String
  planId String
  applicationCode String?
  status SubscriptionStatus @default(TRIAL)
  startsAt DateTime
  trialEndsAt DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  endsAt DateTime?
  suspendedAt DateTime?
  cancelledAt DateTime?
  cancelledBy String?
  cancellationReason String?
  autoRenew Boolean @default(true)
  metadata Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  version Int @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
  entitlementOverrides SubscriptionEntitlementOverride[]
  quotaUsages QuotaUsage[]
  invoices Invoice[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([tenantId, status])
  @@index([currentPeriodEnd])
}

model SubscriptionEntitlementOverride {
  id String @id @default(uuid())
  subscriptionId String
  featureCode String
  valueType EntitlementValueType @default(BOOLEAN)
  enabled Boolean?
  integerValue Int?
  decimalValue Decimal? @db.Decimal(18, 4)
  stringValue String?
  jsonValue Json?
  reason String?
  validFrom DateTime?
  validUntil DateTime?
  createdAt DateTime @default(now())
  createdBy String?
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureCode])
  @@index([featureCode])
}

model QuotaUsage {
  id String @id @default(uuid())
  subscriptionId String
  featureCode String
  periodStart DateTime
  periodEnd DateTime
  usedValue Decimal @default(0) @db.Decimal(18, 4)
  limitValue Decimal? @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureCode, periodStart, periodEnd])
  @@index([subscriptionId])
  @@index([featureCode])
}

model Invoice {
  id String @id @default(uuid())
  tenantId String
  subscriptionId String?
  invoiceNumber String @unique
  status InvoiceStatus @default(DRAFT)
  currency String @default("MGA") @db.VarChar(3)
  subtotal Decimal @default(0) @db.Decimal(18, 2)
  taxTotal Decimal @default(0) @db.Decimal(18, 2)
  discountTotal Decimal @default(0) @db.Decimal(18, 2)
  total Decimal @default(0) @db.Decimal(18, 2)
  amountPaid Decimal @default(0) @db.Decimal(18, 2)
  amountDue Decimal @default(0) @db.Decimal(18, 2)
  issuedAt DateTime?
  dueAt DateTime?
  paidAt DateTime?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  items InvoiceItem[]
  payments Payment[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
}

model InvoiceItem {
  id String @id @default(uuid())
  invoiceId String
  code String?
  description String
  quantity Decimal @default(1) @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 2)
  subtotal Decimal @db.Decimal(18, 2)
  taxAmount Decimal @default(0) @db.Decimal(18, 2)
  total Decimal @db.Decimal(18, 2)
  metadata Json?
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
