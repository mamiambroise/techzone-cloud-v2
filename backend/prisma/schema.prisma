// MODELS â€” Data Model (BM-CDC-03)

model BmEntity {
  id                  String         @id @default(uuid()) @db.Uuid
  applicationId       String         @db.Uuid
  applicationVersionId String         @db.Uuid
  code                String         @db.VarChar(100)
  name                String         @db.VarChar(255)
  pluralName          String?        @db.VarChar(255)
  description         String?
  icon                String?        @db.VarChar(50)
  status              BmEntityStatus @default(DRAFT)
  scope               BmDataScope?
  classification      BmDataClassification?
  version             String         @default("1.0.0") @db.VarChar(50)
  tenantId            String?        @db.Uuid

  fields         BmField[]        @relation("EntityFields")
  constraints    BmConstraint[]   @relation("EntityConstraints")
  indexes        BmIndex[]        @relation("EntityIndexes")
  computedFields BmComputedField[] @relation("EntityComputedFields")
  businessRecords BusinessRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, applicationId, applicationVersionId, code])
  @@index([applicationVersionId])
  @@index([tenantId])
  @@index([status])
  @@map("bm_entities")
}

/// Tenant-safe runtime values for an entity defined by Business Manager.
/// `entityCode` and `schemaVersion` retain a durable application-level identity
/// when a later ApplicationVersion evolves the definition.
model BusinessRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  applicationId       String   @db.Uuid
  entityId            String   @db.Uuid
  entityCode          String   @db.VarChar(100)
  schemaVersion       String   @db.VarChar(50)
  data                Json
  createdBy           String?
  updatedBy           String?
  archivedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  entity BmEntity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@index([tenantId, applicationId, entityCode, archivedAt])
  @@index([tenantId, entityId, archivedAt])
  @@index([applicationId, entityCode])
  @@map("business_records")
}

model BmField {
  id            String            @id @default(uuid()) @db.Uuid
  entityId      String            @db.Uuid
  code          String            @db.VarChar(100)
  label         String?           @db.VarChar(255)
  description   String?
  type          BmDataTypeCode
  required      Boolean           @default(false)
  unique        Boolean           @default(false)
  readonly      Boolean           @default(false)
  indexed       Boolean           @default(false)
  defaultValue  String?
  position      Int               @default(0)
  scope         BmDataScope?
  classification BmDataClassification?
  configuration Json?
  version       String?           @db.VarChar(50)
  tenantId      String?           @db.Uuid

  validations  BmFieldValidation[]
  constraints  BmConstraint[]     @relation("FieldConstraints")

  entity BmEntity @relation("EntityFields", fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([entityId])
  @@index([tenantId])
  @@map("bm_fields")
}

model BmFieldValidation {
  id             String            @id @default(uuid()) @db.Uuid
  fieldId        String            @db.Uuid
  validationType BmValidationType
  value          String?
  message        String?
  configuration  Json?
  version        String?           @db.VarChar(50)
  tenantId       String?           @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  field BmField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@index([tenantId])
  @@map("bm_field_validations")
}

model BmRelation {
  id                  String             @id @default(uuid()) @db.Uuid
  applicationVersionId String             @db.Uuid
  sourceEntityId       String             @db.Uuid
  targetEntityId       String             @db.Uuid
  code                 String             @db.VarChar(100)
  relationType         BmRelationType   @default(ONE_TO_MANY)
  sourceLabel          String?
  targetLabel          String?
  required             Boolean            @default(false)
  deleteBehavior       BmDeleteBehavior   @default(RESTRICT)
  configuration        Json?
  version              String?            @db.VarChar(50)
  tenantId             String?            @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationVersionId, sourceEntityId, targetEntityId, code])
  @@index([applicationVersionId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("bm_relations")
}

model BmConstraint {
  id             String            @id @default(uuid()) @db.Uuid
  entityId       String            @db.Uuid
  fieldId        String?           @db.Uuid
  code           String            @db.VarChar(100)
  constraintType BmConstraintType @default(UNIQUE)
  name           String?           @db.VarChar(255)
  definition     Json?
  version        String?           @db.VarChar(50)
  tenantId       String?           @db.Uuid

  entity BmEntity  @relation("EntityConstraints", fields: [entityId], references: [id], onDelete: Cascade)
  field  BmField?   @relation("FieldConstraints", fields: [fieldId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([entityId])
  @@index([fieldId])
  @@index([tenantId])
  @@map("bm_constraints")
}

model BmIndex {
  id        String      @id @default(uuid()) @db.Uuid
  entityId  String      @db.Uuid
  code      String      @db.VarChar(100)
  name      String?     @db.VarChar(255)
  indexType BmIndexType @default(SIMPLE)
  unique    Boolean     @default(false)
  definition Json?
  version   String?     @db.VarChar(50)
  tenantId  String?     @db.Uuid

  fields BmIndexField[] @relation("IndexFields")

  entity BmEntity @relation("EntityIndexes", fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([entityId])
  @@index([tenantId])
  @@map("bm_indexes")
}

model BmIndexField {
  id       String @id @default(uuid()) @db.Uuid
  indexId  String @db.Uuid
  fieldId  String @db.Uuid
  sort     String @default("ASC") @db.VarChar(10)
  position Int    @default(0)

  index BmIndex @relation("IndexFields", fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, fieldId, position])
  @@index([indexId])
  @@index([fieldId])
  @@map("bm_index_fields")
}

model BmComputedField {
  id                  String   @id @default(uuid()) @db.Uuid
  entityId            String   @db.Uuid
  applicationId       String   @db.Uuid
  applicationVersionId String  @db.Uuid
  code                String   @db.VarChar(100)
  name                String   @db.VarChar(255)
  expression          String?
  targetFieldCode     String?
  description         String?
  configuration       Json?
  version             String? @db.VarChar(50)
  tenantId            String? @db.Uuid

  entity BmEntity @relation("EntityComputedFields", fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([applicationVersionId, entityId, code])
  @@index([applicationVersionId])
  @@index([entityId])
  @@index([tenantId])
  @@map("bm_computed_fields")
}

