model Identity {
  id            String         @id @default(uuid())
  type          IdentityType
  status        IdentityStatus @default(PENDING)
  provider      String?
  subject       String?
  email         String?
  phone         String?
  confidence    Float?
  verifiedAt    DateTime?
  metadata      Json?
  statusChangedAt    DateTime?
  statusChangedBy    String?
  statusChangedReason String?
  createdAt     DateTime       @default(now())
  createdBy     String?
  updatedAt     DateTime       @updatedAt
  updatedBy     String?
  archivedAt    DateTime?
  version       Int            @default(1)

  userLinks     UserIdentity[]
  externalLinks ExternalIdentityLink[]
  serviceAccount ServiceAccount?

  @@unique([provider, subject])
  @@index([type])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("identity")
}

model UserIdentity {
  id          String    @id @default(uuid())
  userId      String
  identityId  String
  isPrimary   Boolean   @default(false)
  linkedAt    DateTime  @default(now())
  linkedBy    String?
  unlinkedAt  DateTime?
  unlinkedBy  String?

  user     IamUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([userId, identityId])
  @@index([userId])
  @@index([identityId])
  @@map("user_identity")
}

model ExternalIdentityLink {
  id                  String  @id @default(uuid())
  identityId          String
  providerType        String
  providerInstanceId  String
  externalSubjectId   String
  externalEntityType  String?
  confidence          Float?
  verified            Boolean @default(false)
  verifiedAt          DateTime?
  lastSyncAt          DateTime?
  disabledAt          DateTime?
  metadata            Json?
  createdAt           DateTime @default(now())
  createdBy           String?
  updatedAt           DateTime @updatedAt
  identity            Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([providerType, providerInstanceId, externalSubjectId])
  @@index([identityId])
  @@map("external_identity_link")
}

model Tenant {
  id                  String        @id @default(uuid()) @db.Uuid
  code                String        @unique
  name                String
  description         String?
  status              TenantStatus  @default(PENDING)
  locale              String?
  timezone            String?
  metadata            Json?
  statusChangedAt     DateTime?
  statusChangedBy     String?
  statusChangedReason String?
  createdAt           DateTime      @default(now())
  createdBy           String?
  updatedAt           DateTime      @updatedAt
  updatedBy           String?
  archivedAt          DateTime?
  version             Int           @default(1)

  defaultUsers        IamUser[]     @relation("DefaultTenantUsers")
  organizations       Organization[]
  applications        Application[]
  memberships         Membership[]
  groups              Group[]
  roles               Role[]
  policies            AccessPolicy[]
  serviceAccounts     ServiceAccount[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  delegations         AdminDelegation[]
  billingAccounts     BillingAccount[]
  billingPayments     Payment[]
  billingCredits      Credit[]
  billingAdjustments  Adjustment[]

  @@index([status])
  @@map("tenant")
}

model Organization {
  id                  String            @id @default(uuid())
  tenantId            String @db.Uuid
  code                String
  name                String
  description         String?
  status              OrganizationStatus @default(ACTIVE)
  metadata            Json?
  statusChangedAt     DateTime?
  statusChangedBy     String?
  statusChangedReason String?
  createdAt           DateTime          @default(now())
  createdBy           String?
  updatedAt           DateTime          @updatedAt
  updatedBy           String?
  archivedAt          DateTime?
  version             Int               @default(1)

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  sites     Site[]
  memberships Membership[]
  groups    Group[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@map("organization")
}

model Site {
  id                  String    @id @default(uuid())
  organizationId      String
  code                String
  name                String
  description         String?
  status              SiteStatus @default(ACTIVE)
  metadata            Json?
  statusChangedAt     DateTime?
  statusChangedBy     String?
  statusChangedReason String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  archivedAt          DateTime?
  version             Int      @default(1)

  organization   Organization  @relation(fields: [organizationId], references: [id])
  memberships    Membership[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("site")
}

model Membership {
  id                  String           @id @default(uuid())
  userId              String
  tenantId            String @db.Uuid
  organizationId      String?
  siteId              String?
  status              MembershipStatus @default(INVITED)
  validFrom           DateTime?
  validUntil          DateTime?
  joinedAt            DateTime?
  revokedAt           DateTime?
  revokedBy           String?
  revokeReason        String?
  metadata            Json?
  createdAt           DateTime @default(now())
  createdBy           String?
  updatedAt           DateTime @updatedAt
  updatedBy           String?
  version             Int      @default(1)

  user         IamUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  site         Site?         @relation(fields: [siteId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([siteId])
  @@index([status])
  @@index([tenantId, status])
  @@map("membership")
}

model Group {
  id                  String    @id @default(uuid())
  tenantId            String @db.Uuid
  organizationId      String?
  code                String
  name                String
  description         String?
  type                GroupType @default(STATIC)
  dynamicRule         Json?
  active              Boolean   @default(true)
  metadata            Json?
  createdAt           DateTime  @default(now())
  createdBy           String?
  updatedAt           DateTime  @updatedAt
  updatedBy           String?
  archivedAt          DateTime?
  version             Int       @default(1)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  organization Organization?  @relation(fields: [organizationId], references: [id])
  members      GroupMember[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([organizationId])
  @@map("groups")
}

model GroupMember {
  id          String    @id @default(uuid())
  groupId     String
  userId      String
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String?
  removedAt   DateTime?
  removedBy   String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  IamUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_member")
}

model Permission {
  id           String @id @default(uuid())
  code         String @unique
  resource     String
  action       String
  name         String
  description  String?
  critical     Boolean @default(false)
  active       Boolean @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  rolePermissions RolePermission[]

  @@index([resource, action])
  @@index([active])
  @@map("permission")
}

model Role {
  id                  String    @id @default(uuid())
  tenantId            String? @db.Uuid
  code                String
  name                String
  description         String?
  status              RoleStatus @default(ACTIVE)
  system              Boolean   @default(false)
  privileged          Boolean   @default(false)
  metadata            Json?
  statusChangedAt     DateTime?
  statusChangedBy     String?
  statusChangedReason String?
  createdAt           DateTime @default(now())
  createdBy           String?
  updatedAt           DateTime @updatedAt
  updatedBy           String?
  archivedAt          DateTime?
  version             Int      @default(1)

  tenant        Tenant?            @relation(fields: [tenantId], references: [id])
  permissions   RolePermission[]
  assignments   RoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@map("role")
}

model RolePermission {
  roleId        String
  permissionId  String
  grantedAt     DateTime  @default(now())
  grantedBy     String?
  revokedAt     DateTime?
  revokedBy     String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model RoleAssignment {
  id                  String    @id @default(uuid())
  roleId              String
  userId              String?
  groupId             String?
  serviceAccountId    String?
  tenantId            String? @db.Uuid
  organizationId      String?
  siteId              String?
  validFrom           DateTime?
  validUntil          DateTime?
  temporary           Boolean   @default(false)
  delegated           Boolean   @default(false)
  assignedBy          String?
  createdAt           DateTime  @default(now())
  revokedAt           DateTime?
  revokedBy           String?
  revokeReason        String?

  role            Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user            IamUser?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group           Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  serviceAccount  ServiceAccount?   @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([userId])
  @@index([groupId])
  @@index([serviceAccountId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([siteId])
  @@map("role_assignment")
}

model AccessPolicy {
  id                  String       @id @default(uuid())
  tenantId            String? @db.Uuid
  code                String
  name                String
  description         String?
  status              PolicyStatus @default(DRAFT)
  effect              PolicyEffect
  priority            Int          @default(100)
  resource            String?
  action              String?
  subjectType         String?
  subjectRef          String?
  version             Int          @default(1)
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  publishedAt         DateTime?
  supersededById      String?
  metadata            Json?
  createdAt           DateTime     @default(now())
  createdBy           String?
  updatedAt           DateTime     @updatedAt
  updatedBy           String?
  archivedAt          DateTime?

  tenant      Tenant?            @relation(fields: [tenantId], references: [id])
  conditions  PolicyCondition[]

  @@unique([tenantId, code, version])
  @@index([tenantId])
  @@index([status])
  @@index([resource, action])
  @@index([effectiveFrom, effectiveUntil])
  @@map("access_policy")
}

model PolicyCondition {
  id          String   @id @default(uuid())
  policyId    String
  attribute   String
  operator    String
  value       Json?
  sortOrder   Int      @default(0)
  metadata    Json?

  policy AccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([attribute])
  @@map("policy_condition")
}

model AuthorizationDecision {
  id                String              @id @default(uuid())
  traceId           String
  userId            String?
  identityId        String?
  tenantId          String? @db.Uuid
  organizationId    String?
  siteId            String?
  applicationId     String?
  environment       IamEnvironment?
  resource          String
  action            String
  result            AuthorizationResult
  matchedRoleIds    Json?
  matchedPermissionIds Json?
  matchedPolicyIds  Json?
  reason            Json?
  riskLevel         RiskLevel?
  createdAt         DateTime @default(now())

  @@index([traceId])
  @@index([userId])
  @@index([tenantId])
  @@index([resource, action])
  @@index([createdAt])
  @@map("authorization_decision")
}

model MfaMethod {
  id          String   @id @default(uuid())
  userId      String
  type        MfaType
  label       String?
  secretRef   String?
  enabled     Boolean  @default(false)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  verifiedAt  DateTime?
  lastUsedAt  DateTime?
  disabledAt  DateTime?
  metadata    Json?

  user IamUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([enabled])
  @@map("mfa_method")
}

model RecoveryCode {
  id          String   @id @default(uuid())
  userId      String
  codeHash    String   @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  usedAt      DateTime?

  user IamUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_code")
}

model ServiceAccount {
  id                  String                @id @default(uuid())
  tenantId            String @db.Uuid
  identityId          String                @unique
  code                String
  name                String
  description         String?
  status              ServiceAccountStatus  @default(ACTIVE)
  metadata            Json?
  statusChangedAt     DateTime?
  statusChangedBy     String?
  statusChangedReason String?
  createdAt           DateTime              @default(now())
  createdBy           String?
  updatedAt           DateTime              @updatedAt
  updatedBy           String?
  archivedAt          DateTime?
  version             Int                   @default(1)

  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  identity            Identity                @relation(fields: [identityId], references: [id])
  credentials         ServiceAccountCredential[]
  roleAssignments     RoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@map("service_account")
}

model ServiceAccountCredential {
  id              String @id @default(uuid())
  serviceAccountId String
  keyId           String @unique
  secretHash      String?
  secretRef       String?
  status          IamCredentialStatus @default(ACTIVE)
  scopes          Json?
  createdAt       DateTime @default(now())
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  revokedBy       String?
  revokeReason    String?

  serviceAccount ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([serviceAccountId])
  @@index([status])
  @@map("service_account_credential")
}

model SecurityEvent {
  id            String          @id @default(uuid())
  traceId       String?
  type          String
  severity      SecuritySeverity
  userId        String?
  identityId    String?
  tenantId      String? @db.Uuid
  organizationId String?
  siteId        String?
  sessionId     String?
  deviceId      String?
  riskLevel     RiskLevel?
  source        String?
  metadata      Json?
  occurredAt    DateTime        @default(now())

  @@index([traceId])
  @@index([userId])
  @@index([tenantId])
  @@index([type])
  @@index([severity])
  @@index([occurredAt])
  @@map("security_event")
}

model ContextSnapshot {
  id              String    @id @default(uuid())
  traceId         String?
  userId          String
  identityId      String?
  tenantId        String? @db.Uuid
  organizationId  String?
  siteId          String?
  applicationId   String?
  environment     IamEnvironment?
  sessionId       String?
  roles           Json
  permissions     Json
  policies        Json?
  authentication  Json
  security        Json
  subscriptionContext Json?
  entitlementContext Json?
  sourceRevision  String?
  resolvedAt      DateTime  @default(now())
  expiresAt       DateTime?

  @@index([userId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([traceId])
  @@index([resolvedAt])
  @@map("context_snapshot")
}

model ContextSwitchEvent {
  id              String    @id @default(uuid())
  traceId         String?
  userId          String
  sessionId       String?
  fromTenantId    String?
  fromOrganizationId String?
  fromSiteId      String?
  toTenantId      String?
  toOrganizationId String?
  toSiteId        String?
  previousContextId String?
  resolvedContextId String?
  result          String
  reason          String?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([traceId])
  @@index([createdAt])
  @@map("context_switch_event")
}

model ContextInvalidation {
  id              String   @id @default(uuid())
  subjectType     String
  subjectId       String
  tenantId        String? @db.Uuid
  reason          String
  revision        Int      @default(1)
  sourceEventType String?
  sourceEventId   String?
  createdAt       DateTime @default(now())
  processedAt     DateTime?

  @@index([subjectType, subjectId])
  @@index([tenantId])
  @@index([processedAt])
  @@index([createdAt])
  @@map("context_invalidation")
}

model AuditEvent {
  id              String   @id @default(uuid())
  traceId         String
  actorId         String?
  effectiveIdentityId String?
  effectiveUserId String?
  tenantId        String? @db.Uuid
  organizationId  String?
  siteId          String?
  sessionId       String?
  action          String
  targetType      String?
  targetId        String?
  result          String
  reason          String?
  before          Json?
  after           Json?
  metadata        Json?
  previousHash    String?
  eventHash       String?
  createdAt       DateTime @default(now())

  @@index([traceId])
  @@index([actorId])
  @@index([effectiveUserId])
  @@index([tenantId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_event")
}

model OutboxEvent {
  id          String   @id @default(uuid())
  aggregateType String
  aggregateId  String
  eventType      String
  payload       Json
  traceId       String?
  createdAt     DateTime @default(now())
  publishedAt   DateTime?
  retryCount    Int      @default(0)
  lastError     String?

  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("outbox_event")
}

// ==================================================================================================================
// SUBSCRIPTION & BILLING (CDC 15)
//
// Modèle fondamental (CDC 6) :
//   Tenant -> BillingAccount -> Subscription -> Plan/Price -> Entitlements -> Usage -> Invoice -> Payment
//
// RG-BILL-005 : Price est séparé de Plan pour qu'un changement de tarif n'écrase jamais
//               l'identité du plan ni l'historique financier d'une facture (RG-BILL-008/009).
// RG-BILL-027 : Subscription, Invoice, Payment, Usage, BillingAccount, Credit et Adjustment
//               portent tous tenantId. Seuls Product, Plan, Price, Meter et Feature sont
//               PLATFORM GLOBAL (CDC 83) — la frontière de sécurité y est la permission.
// ==================================================================================================================

/// Produit commercial du catalogue. Distinct du Registry technique (CDC 7).
model BillingProduct {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  features    Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  archivedAt  DateTime?

  plans Plan[]

  @@index([status])
  @@map("billing_product")
}

/// Un Plan définit un ensemble commercial cohérent. Le prix n'est PAS porté par le Plan.
model Plan {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?
  status          PlanStatus      @default(DRAFT)
  billingModel    PricingModel    @default(FLAT)
  billingInterval BillingInterval @default(MONTHLY)
  intervalCount   Int             @default(1)
  trialDays       Int?
  metadata        Json?
  productId       String?
  createdAt       DateTime        @default(now())
  createdBy       String?
  updatedAt       DateTime        @updatedAt
  updatedBy       String?
  archivedAt      DateTime?
  version         Int             @default(1)

  product      BillingProduct?     @relation(fields: [productId], references: [id])
  prices       Price[]
  entitlements PlanEntitlement[]
  subscriptions Subscription[]

  @@index([status])
  @@index([productId])
  @@map("plan")
}

/// Prix versionné. Un ancien prix passe INACTIVE, il n'est jamais écrasé (CDC 45/95/96).
model Price {
  id             String          @id @default(uuid())
  planId         String
  currency       String          @db.VarChar(3)
  amount         Decimal         @db.Decimal(18, 2)
  interval       BillingInterval
  intervalCount  Int             @default(1)
  pricingModel   PricingModel    @default(FLAT)
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  status         PriceStatus     @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime        @default(now())
  createdBy      String?
  updatedAt      DateTime        @updatedAt

  plan           Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]
  invoiceLines   InvoiceItem[]

  @@unique([planId, currency, interval, intervalCount, effectiveFrom])
  @@index([planId, status])
  @@index([currency])
  @@map("billing_price")
}

/// Entitlement de base d'un Plan. L'override par abonnement passe par
/// SubscriptionEntitlementOverride ; l'usage par QuotaUsage/UsageAggregate.
model PlanEntitlement {
  id           String               @id @default(uuid())
  planId       String
  featureCode  String
  kind         EntitlementKind      @default(BOOLEAN)
  valueType    EntitlementValueType @default(BOOLEAN)
  enabled      Boolean              @default(true)
  integerValue Int?
  decimalValue Decimal?             @db.Decimal(18, 4)
  stringValue  String?
  jsonValue    Json?
  unit         String?
  enforcement  EnforcementPolicy    @default(SOFT_LIMIT)
  meterKey     String?
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@index([featureCode])
  @@map("plan_entitlement")
}

/// Payeur. CDC 6/30 : ne jamais supposer que l'utilisateur est le payeur.
model BillingAccount {
  id             String              @id @default(uuid())
  tenantId       String              @db.Uuid
  customerName   String
  billingEmail   String
  billingAddress Json?
  taxInformation Json?
  currency       String              @default("MGA") @db.VarChar(3)
  status         BillingAccountStatus @default(ACTIVE)

  // Billing Profile (CDC 31)
  legalName       String?
  billingContact  String?
  taxIdentifier   String?
  invoiceLanguage String              @default("fr")
  paymentTerms    Int?

  metadata  Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  subscriptions Subscription[]
  invoices      Invoice[]
  credits       Credit[]

  @@index([tenantId])
  @@index([status])
  @@map("billing_account")
}

model Subscription {
  id              String             @id @default(uuid())
  tenantId        String @db.Uuid
  billingAccountId String?
  planId          String
  priceId         String?
  applicationCode String?
  status          SubscriptionStatus @default(DRAFT)
  startsAt        DateTime
  trialEndsAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingAt   DateTime?
  renewalAt       DateTime?

  graceEndsAt     DateTime?
  graceDays       Int?

  suspendReason   String?
  suspendedAt     DateTime?
  cancelAt        DateTime?
  cancelRequestedAt DateTime?
  cancelRequestedBy String?
  cancellationMode CancellationMode?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancellationReason String?
  endsAt          DateTime?
  endedAt         DateTime?

  autoRenew       Boolean          @default(true)
  metadata        Json?
  createdAt       DateTime         @default(now())
  createdBy       String?
  updatedAt       DateTime         @updatedAt
  updatedBy       String?
  version         Int              @default(1)

  tenant        Tenant                        @relation(fields: [tenantId], references: [id])
  billingAccount BillingAccount?              @relation(fields: [billingAccountId], references: [id])
  plan          Plan                          @relation(fields: [planId], references: [id])
  price         Price?                        @relation(fields: [priceId], references: [id])
  entitlementOverrides SubscriptionEntitlementOverride[]
  quotaUsages         QuotaUsage[]
  invoices            Invoice[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([tenantId, status])
  @@index([currentPeriodEnd])
  @@index([nextBillingAt])
  @@map("subscription")
}

/// Override commercial explicite, borné et audité (CDC 58).
model SubscriptionEntitlementOverride {
  id            String                 @id @default(uuid())
  subscriptionId String
  featureCode   String
  valueType     EntitlementValueType   @default(BOOLEAN)
  enabled       Boolean?
  integerValue  Int?
  decimalValue  Decimal?               @db.Decimal(18, 4)
  stringValue   String?
  jsonValue     Json?
  reason        String?
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime               @default(now())
  createdBy     String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureCode])
  @@index([featureCode])
  @@map("subscription_entitlement_override")
}

/// État de limite et de quota pour une période de facturation donnée (CDC 20/21).
model QuotaUsage {
  id            String   @id @default(uuid())
  subscriptionId String
  featureCode   String
  periodStart   DateTime
  periodEnd     DateTime
  usedValue     Decimal  @default(0) @db.Decimal(18, 4)
  limitValue    Decimal? @db.Decimal(18, 4)
  unit          String?
  enforcement   EnforcementPolicy @default(SOFT_LIMIT)
  updatedAt     DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureCode, periodStart, periodEnd])
  @@index([subscriptionId])
  @@index([featureCode])
  @@map("quota_usage")
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String @db.Uuid
  billingAccountId String?
  subscriptionId String?
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("MGA") @db.VarChar(3)
  subtotal      Decimal       @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal Decimal       @default(0) @db.Decimal(18, 2)
  creditApplied Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @default(0) @db.Decimal(18, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(18, 2)
  amountDue     Decimal       @default(0) @db.Decimal(18, 2)
  periodStart   DateTime?
  periodEnd     DateTime?
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  voidReason    String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  createdBy     String?
  updatedAt     DateTime      @updatedAt

  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
  billingAccount BillingAccount? @relation(fields: [billingAccountId], references: [id])
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  adjustments   Adjustment[]
  credits       Credit[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
  @@map("invoice")
}

/// Une ligne doit expliquer le montant (CDC 34). priceId fige le tarif historique :
/// un changement de catalogue ne modifie pas une facture émise (RG-BILL-009).
model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  priceId     String?
  code        String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal  @db.Decimal(18, 2)
  subtotal    Decimal  @db.Decimal(18, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(18, 2)
  discount    Decimal  @default(0) @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)
  sourceType  String?
  sourceRef   String?
  periodStart DateTime?
  periodEnd   DateTime?
  metadata    Json?

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  price   Price?  @relation(fields: [priceId], references: [id])

  @@index([invoiceId])
  @@index([sourceType])
  @@map("invoice_item")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String @db.Uuid
  invoiceId      String
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @default("MGA") @db.VarChar(3)
  method         PaymentMethod @default(MANUAL)
  provider       String?
  externalReference String?
  status         PaymentStatus @default(PENDING)

  // RG-BILL-021 : une même clé d'idempotence ne produit jamais deux débits.
  idempotencyKey String?

  // Paiement manuel (CDC 49) : la validation exige une permission IAM explicite.
  proofReference String?
  notes          String?
  validatedBy    String?
  validatedAt    DateTime?

  initiatedAt    DateTime      @default(now())
  completedAt    DateTime?
  failedAt       DateTime?
  refundedAt     DateTime?
  failureCode    String?
  failureMessage String?
  refundAmount   Decimal?      @db.Decimal(18, 2)
  refundReason   String?
  metadata       Json?

  invoice  Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant   Tenant?          @relation(fields: [tenantId], references: [id])
  attempts PaymentAttempt[]

  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@index([externalReference])
  @@unique([tenantId, idempotencyKey])
  @@map("payment")
}

model PaymentAttempt {
  id             String        @id @default(uuid())
  attemptId      String        @unique
  paymentId      String
  provider       String?
  providerReference String?
  status         PaymentStatus @default(PENDING)
  errorCode      String?
  correlationId  String?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_attempt")
}

model Credit {
  id               String       @id @default(uuid())
  tenantId         String @db.Uuid
  billingAccountId String?
  invoiceId        String?
  amount           Decimal      @db.Decimal(18, 2)
  remainingAmount  Decimal      @db.Decimal(18, 2)
  currency         String       @default("MGA") @db.VarChar(3)
  reason           String
  source           String
  status           CreditStatus @default(AVAILABLE)
  expiresAt        DateTime?
  createdAt        DateTime     @default(now())
  createdBy        String?

  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  billingAccount BillingAccount? @relation(fields: [billingAccountId], references: [id])
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("billing_credit")
}

model Adjustment {
  id         String         @id @default(uuid())
  tenantId   String @db.Uuid
  invoiceId  String?
  type       AdjustmentType
  amount     Decimal        @db.Decimal(18, 2)
  currency   String         @default("MGA") @db.VarChar(3)
  reason     String
  createdBy  String
  createdAt  DateTime       @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("billing_adjustment")
}

/// Définition d'une métrique mesurable. PLATFORM GLOBAL (CDC 83).
model Meter {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  unit        String
  aggregation MeterAggregation @default(SUM)
  period      MeterPeriod      @default(BILLING_PERIOD)
  status      String           @default("ACTIVE")
  entitlementCode String?
  description String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  aggregates UsageAggregate[]

  @@index([status])
  @@index([entitlementCode])
  @@map("meter")
}

/// Événement de consommation brut. eventId assure l'idempotence (CDC 26, RG-BILL-011/012).
model UsageEvent {
  id             String   @id @default(uuid())
  eventId        String   @unique
  tenantId       String @db.Uuid
  subscriptionId String?
  meterKey       String
  quantity       Decimal  @db.Decimal(18, 4)
  unit           String
  occurredAt     DateTime
  source         String
  resourceId     String?
  correlationId  String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([tenantId, meterKey, occurredAt])
  @@index([tenantId])
  @@index([meterKey])
  @@map("usage_event")
}

/// Agrégat tenant x meter x période de facturation (CDC 27).
model UsageAggregate {
  id             String   @id @default(uuid())
  tenantId       String @db.Uuid
  subscriptionId String?
  meterKey       String
  periodStart    DateTime
  periodEnd      DateTime
  value          Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt

  meter Meter @relation(fields: [meterKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, meterKey, periodStart, periodEnd])
  @@index([tenantId])
  @@map("usage_aggregate")
}

/// Journal d'événement Billing (CDC 76) + journal d'audit métier (CDC 79).
model BillingEvent {
  id            String   @id @default(uuid())
  traceId       String?
  tenantId      String @db.Uuid
  subscriptionId String?
  invoiceId     String?
  paymentId     String?
  eventType     String
  payload       Json?
  occurredAt    DateTime @default(now())

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("billing_event")
}

/// Diagnostic Billing (CDC 101). Ne contient aucun secret ni donnée de paiement.
model BillingDiagnostic {
  id            String                 @id @default(uuid())
  stage         BillingStage
  status        BillingDiagnosticStatus @default(UNKNOWN)
  code          String?
  message       String?
  resource      String?
  correlationId String?
  traceId       String?
  tenantId      String?                @db.Uuid
  details       Json?
  checkedAt     DateTime               @default(now())

  @@index([stage])
  @@index([status])
  @@index([tenantId])
  @@index([checkedAt])
  @@map("billing_diagnostic")
}

/// Dédoublonnage des webhooks providers. RG-BILL-022 : un webhook non vérifié ne
/// modifie jamais un Payment ; cette table n'est écrite qu'après vérification.
model BillingWebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  providerEventId String
  signatureValid  Boolean
  processed       Boolean  @default(false)
  processedAt     DateTime?
  payload         Json
  receivedAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([provider])
  @@map("billing_webhook_event")
}

model AdminDelegation {
  id                  String  @id @default(uuid())
  tenantId            String? @db.Uuid
  grantorUserId       String
  granteeUserId       String
  scopeType           String
  scopeId             String?
  permissions         Json
  status              DelegationStatus @default(ACTIVE)
  validFrom           DateTime @default(now())
  validUntil          DateTime?
  reason              String?
  createdAt           DateTime @default(now())
  createdBy           String?
  revokedAt           DateTime?
  revokedBy           String?
  tenant              Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([grantorUserId])
  @@index([granteeUserId])
  @@index([status])
  @@map("admin_delegation")
}

model AdministrativeAction {
  id              String  @id @default(uuid())
  traceId         String?
  actorId         String
  tenantId        String? @db.Uuid
  actionType      String
  targetType      String
  targetId        String?
  status          AdminActionStatus @default(REQUESTED)
  reason          String?
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  executedAt      DateTime?
  completedAt     DateTime?
  failureReason   String?
  metadata        Json?

  @@index([traceId])
  @@index([actorId])
  @@index([tenantId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([requestedAt])
  @@map("administrative_action")
}

model PlatformService {
  id              String  @id @default(uuid())
  code            String  @unique
  name            String
  description     String?
  status          PlatformServiceStatus @default(STARTING)
  version         String?
  baseUrl         String?
  environment     IamEnvironment?
  metadata        Json?
  lastHealthCheckAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  diagnostics PlatformDiagnostic[]

  @@index([status])
  @@index([environment])
  @@map("platform_service")
}

model PlatformDiagnostic {
  id          String  @id @default(uuid())
  serviceId   String?
  component   String
  status      DiagnosticStatus @default(UNKNOWN)
  severity    SecuritySeverity?
  message     String?
  details     Json?
  traceId     String?
  checkedAt   DateTime @default(now())
  resolvedAt  DateTime?

  service PlatformService? @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@index([component])
  @@index([status])
  @@index([checkedAt])
  @@map("platform_diagnostic")
}

model PlatformMaintenance {
  id          String  @id @default(uuid())
  title       String
  description String?
  component   String?
  environment IamEnvironment?
  startsAt    DateTime
  endsAt      DateTime?
  active      Boolean @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  metadata    Json?

  @@index([active])
  @@index([startsAt])
  @@index([environment])
  @@map("platform_maintenance")
}

/// Référentiel des clés d'entitlement autorisées sur la plateforme (CDC 17/18).
/// PLATFORM GLOBAL : la frontière de sécurité est la permission, pas le tenant (CDC 83).
/// Une Feature décrit une DROIT COMMERCIAL, jamais une permission IAM (RG-BILL-004).
model Feature {
  code        String          @id
  name        String
  description String?
  status      String          @default("ACTIVE")
  metered     Boolean         @default(false)
  quotaCode   String?
  kind        EntitlementKind @default(BOOLEAN)
  unit        String?
  meterKey    String?
  enforcement EnforcementPolicy @default(SOFT_LIMIT)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([kind])
  @@map("feature")
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  providerEventId String   @unique
  signatureValid  Boolean
  processed       Boolean  @default(false)
  processedAt     DateTime?
  payload         Json
  receivedAt      DateTime @default(now())

  @@index([provider])
  @@map("webhook_event")
}


