// Prisma schema
// Techzone Cloud - Team 4
// Platform Foundation - PF-CDC-02

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum ApplicationStatus {
  ACTIVE
  ARCHIVED
  DISABLED
}

enum ApplicationVersionStatus {
  DRAFT
  CONFIGURING
  VALIDATING
  READY
  ACTIVE
  SUPERSEDED
  DEPRECATED
  ARCHIVED
}

enum EnvironmentType {
  DEVELOPMENT
  TEST
  STAGING
  PRODUCTION
}

enum EnvironmentStatus {
  ACTIVE
  MAINTENANCE
  DEGRADED
  DISABLED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  VALIDATING
  LOCKED
  ACTIVE
  DEPRECATED
  RETIRED
}

/**
 * ==================================================================================================================
 * PLATFORM MODELS
 * ==================================================================================================================
 */

// APPLICATION

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @db.VarChar(100)
  name        String            @db.VarChar(255)
  description String?
  status      ApplicationStatus @default(ACTIVE)
  tenantId    String?           @db.Uuid
  tenantScope String?           @db.VarChar(100) @default("TENANT")

  versions               ApplicationVersion[]
  releases               Release[]
  environmentDeployments EnvironmentDeployment[]
  deploymentHistory      DeploymentHistory[]
  snapshots              Snapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantScope])
  @@index([status])
  @@map("applications")
}

// APPLICATION VERSION

model ApplicationVersion {
  id            String                   @id @default(uuid()) @db.Uuid
  applicationId String                   @db.Uuid
  version       String                   @db.VarChar(50)
  status        ApplicationVersionStatus @default(DRAFT)
  releaseNotes  String?
  createdFrom   String?                  @db.Uuid
  tenantId      String?                  @db.Uuid

  releases Release[]
  packVersions PackVersion[]

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt   DateTime   @default(now())
  publishedAt DateTime?
  snapshots   Snapshot[]

  @@unique([applicationId, version])
  @@index([applicationId])
  @@index([tenantId])
  @@index([status])
  @@map("application_versions")
}

// ENVIRONNEMENT

model Environment {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @db.VarChar(100)
  name             String            @db.VarChar(255)
  type             EnvironmentType
  status           EnvironmentStatus @default(ACTIVE)
  region           String?           @db.VarChar(100)
  baseUrl          String?           @db.VarChar(500)
  configurationRef String?           @db.VarChar(255)
  tenantId         String?           @db.Uuid

  deployments            Deployment[]
  environmentDeployments EnvironmentDeployment[]
  deploymentHistory      DeploymentHistory[]
  history                EnvironmentHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snapshots Snapshot[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@map("environments")
}

enum EnvironmentHistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  CONFIGURATION_CHANGED
  ARCHIVED
}

model EnvironmentHistory {
  id            String @id @default(uuid()) @db.Uuid
  environmentId String @db.Uuid
  tenantId      String? @db.Uuid

  action   EnvironmentHistoryAction
  actor    String?                  @db.VarChar(100)
  changes  Json?
  metadata Json?

  createdAt DateTime @default(now())

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([environmentId])
  @@index([action])
  @@index([createdAt])
  @@map("environment_history")
}

model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  contractCode    String         @db.VarChar(100)
  contractVersion String         @db.VarChar(50)
  ownerTeam       String         @db.VarChar(100)
  status          ContractStatus @default(DRAFT)
  tenantId        String?        @db.Uuid

  schema              Json
  compatibilityPolicy Json

  publishedAt  DateTime?
  deprecatedAt DateTime?

  hash String? @db.VarChar(128)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history   ContractHistory[]
  providers ContractProvider[]
  consumers ContractConsumer[]

  @@unique([tenantId, contractCode, contractVersion])
  @@index([tenantId])
  @@index([contractCode])
  @@index([status])
  @@index([ownerTeam])
  @@map("contracts")
}

enum ContractHistoryAction {
  CREATED
  VALIDATED
  LOCKED
  ACTIVATED
  DEPRECATED
  RETIRED
  COMPATIBILITY_CHECKED
}

model ContractHistory {
  id         String @id @default(uuid()) @db.Uuid
  contractId String @db.Uuid
  tenantId   String? @db.Uuid

  action   ContractHistoryAction
  actor    String?               @db.VarChar(100)
  changes  Json?
  metadata Json?

  createdAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
  @@index([action])
  @@index([createdAt])
  @@map("contract_history")
}

enum ContractParticipantType {
  APPLICATION
  PACK
  SERVICE
  TEAM
  EXTERNAL
}

model ContractProvider {
  id         String @id @default(uuid()) @db.Uuid
  contractId String @db.Uuid

  providerCode String                  @db.VarChar(100)
  providerType ContractParticipantType

  metadata Json?

  createdAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, providerCode])
  @@index([contractId])
  @@index([providerCode])
  @@map("contract_providers")
}

model ContractConsumer {
  id         String @id @default(uuid()) @db.Uuid
  contractId String @db.Uuid

  consumerCode String                  @db.VarChar(100)
  consumerType ContractParticipantType

  supportedVersion String? @db.VarChar(50)

  metadata Json?

  createdAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, consumerCode])
  @@index([contractId])
  @@index([consumerCode])
  @@map("contract_consumers")
}

enum ConfigurationScope {
  PLATFORM
  APPLICATION
  APPLICATION_VERSION
  ENVIRONMENT
  TENANT
}

enum ConfigurationType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
  JSON
  URL
  DURATION
}

enum ConfigurationStatus {
  DRAFT
  VALIDATING
  READY
  ACTIVE
  DEPRECATED
  ARCHIVED
}

model Configuration {
  id  String @id @default(uuid()) @db.Uuid
  key String @db.VarChar(150)

  scope   ConfigurationScope
  scopeId String?            @db.VarChar(100)

  type         ConfigurationType
  value        Json?
  defaultValue Json?

  required Boolean @default(false)
  schema   Json?

  version  String              @default("1.0.0") @db.VarChar(50)
  status   ConfigurationStatus @default(DRAFT)
  tenantId String?             @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history ConfigurationHistory[]

  @@unique([tenantId, key, scope, scopeId, version])
  @@index([tenantId])
  @@index([key])
  @@index([scope, scopeId])
  @@index([status])
  @@map("configurations")
}

enum ConfigurationHistoryAction {
  CREATED
  UPDATED
  VALIDATED
  ACTIVATED
  DEPRECATED
  ARCHIVED
}

model ConfigurationHistory {
  id String @id @default(uuid()) @db.Uuid

  configurationId String @db.Uuid
  tenantId        String? @db.Uuid

  action ConfigurationHistoryAction

  actor String? @db.VarChar(100)

  changes  Json?
  metadata Json?

  createdAt DateTime @default(now())

  configuration Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([configurationId])
  @@index([action])
  @@index([createdAt])
  @@map("configuration_history")
}

enum SnapshotStatus {
  DRAFT
  VALIDATING
  VALID
  INVALID
  ACTIVE
  ARCHIVED
}

enum SnapshotHistoryAction {
  CREATED
  CHANGED
  VALIDATED
  ACTIVATED
  ARCHIVED
}

model Snapshot {
  id String @id @default(uuid()) @db.Uuid

  applicationId        String             @db.Uuid
  applicationVersionId String             @db.Uuid
  environmentId        String             @db.Uuid
  contracts            Json
  configuration        Json
  metadata             Json?
  createdBy            String             @db.VarChar(100)
  createdAt            DateTime           @default(now())
  hash                 String             @db.VarChar(128)
  status               SnapshotStatus     @default(DRAFT)
  tenantId             String?            @db.Uuid
  releases             Release[]
  application          Application        @relation(fields: [applicationId], references: [id])
  applicationVersion   ApplicationVersion @relation(fields: [applicationVersionId], references: [id])
  environment          Environment        @relation(fields: [environmentId], references: [id])
  history              SnapshotHistory[]

  @@unique([applicationVersionId, environmentId, hash])
  @@index([tenantId])
  @@index([applicationId])
  @@index([applicationVersionId])
  @@index([environmentId])
  @@index([status])
  @@index([createdAt])
  @@map("snapshots")
}

model SnapshotHistory {
  id         String @id @default(uuid()) @db.Uuid
  snapshotId String @db.Uuid
  tenantId   String? @db.Uuid

  action    SnapshotHistoryAction
  createdBy String                @db.VarChar(100)
  traceId   String?               @db.VarChar(100)
  reason    String?               @db.Text
  createdAt DateTime              @default(now())
  snapshot  Snapshot              @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([snapshotId])
  @@index([action])
  @@index([createdAt])
  @@map("snapshot_history")
}

/**
 * ==================================================================================================================
 * INTEGRATION MODELS
 * ==================================================================================================================
 */

enum ConnectorProviderType {
  REST
  GRAPHQL
  DATABASE_ADAPTER
  FILE
  MESSAGE_QUEUE
  CUSTOM_PROVIDER
}

enum ConnectorStatus {
  DRAFT
  CONFIGURING
  VALIDATING
  READY
  ACTIVE
  DEGRADED
  DISABLED
  ARCHIVED
}

enum ConnectorHealthStatus {
  HEALTHY
  WARNING
  DEGRADED
  CRITICAL
  UNKNOWN
}

model Connector {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(100)
  name String @db.VarChar(255)

  providerType    ConnectorProviderType
  contractVersion String?               @db.VarChar(50)

  status ConnectorStatus @default(DRAFT)

  configurationSchema Json?
  credentialRef       String? @db.VarChar(255)

  capabilities Json?
  health       ConnectorHealthStatus @default(UNKNOWN)

  synchronizations Synchronization[]
  integrationLogs  IntegrationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerType])
  @@index([status])
  @@index([health])
  @@map("connectors")
}

enum ApiStatus {
  DRAFT
  VALIDATING
  READY
  ACTIVE
  DEPRECATED
  RETIRED
}

enum ApiAuthenticationType {
  NONE
  API_KEY
  BEARER
  OAUTH2
  BASIC
  CUSTOM
}

model ApiDefinition {
  id       String @id @default(uuid()) @db.Uuid
  apiCode  String @db.VarChar(100)
  version  String @db.VarChar(50)
  basePath String @db.VarChar(255)

  operations     Json
  authentication ApiAuthenticationType @default(BEARER)
  authorization  Json?

  rateLimit Json?

  requestSchema  Json?
  responseSchema Json?

  status ApiStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@unique([apiCode, version])
  @@index([apiCode])
  @@index([status])
  @@map("api_definitions")
}

enum WebhookDirection {
  INBOUND
  OUTBOUND
}

enum WebhookStatus {
  DRAFT
  CONFIGURING
  VALIDATING
  READY
  ACTIVE
  DISABLED
  ARCHIVED
}

model Webhook {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique @db.VarChar(100)
  direction WebhookDirection
  event     String           @db.VarChar(150)
  endpoint  String           @db.VarChar(500)

  status WebhookStatus @default(DRAFT)

  secretRef       String? @db.VarChar(255)
  signaturePolicy Json?
  retryPolicy     Json?
  timeout         Int?
  filters         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([direction])
  @@index([event])
  @@index([status])
  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
}

model WebhookDelivery {
  id        String @id @default(uuid()) @db.Uuid
  webhookId String @db.Uuid

  eventId String @db.VarChar(150)
  attempt Int    @default(1)

  status WebhookDeliveryStatus @default(PENDING)

  httpStatus Int?
  duration   Int?

  nextRetryAt DateTime?
  traceId     String?   @db.VarChar(100)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([eventId])
  @@index([status])
  @@index([traceId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

enum CredentialType {
  API_KEY
  BASIC_AUTH
  BEARER_TOKEN
  OAUTH_CLIENT
  CERTIFICATE_REFERENCE
  CUSTOM_SECRET_REFERENCE
}

enum CredentialStatus {
  ACTIVE
  DISABLED
  EXPIRED
  ROTATION_REQUIRED
  ARCHIVED
}

model CredentialReference {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(100)

  type     CredentialType
  provider String           @db.VarChar(100)
  status   CredentialStatus @default(ACTIVE)

  lastRotatedAt DateTime?
  expiresAt     DateTime?

  metadataSafe Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([provider])
  @@index([status])
  @@index([expiresAt])
  @@map("credential_references")
}

enum SynchronizationDirection {
  PULL
  PUSH
  BIDIRECTIONAL
}

enum SynchronizationMode {
  FULL
  INCREMENTAL
}

enum SynchronizationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  PAUSED
  CANCELLED
}

model Synchronization {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(100)

  connectorId String @db.Uuid

  source String @db.VarChar(255)
  target String @db.VarChar(255)

  direction SynchronizationDirection
  mode      SynchronizationMode

  schedule   String? @db.VarChar(100)
  mappingRef String? @db.VarChar(255)

  conflictPolicy Json?
  batchSize      Int?

  status SynchronizationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connector Connector @relation(fields: [connectorId], references: [id])

  @@index([connectorId])
  @@index([direction])
  @@index([mode])
  @@index([status])
  @@map("synchronizations")
}

enum IntegrationLogDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationLogStatus {
  STARTED
  SUCCEEDED
  FAILED
  TIMEOUT
  RETRYING
  CANCELLED
}

model IntegrationLog {
  id String @id @default(uuid()) @db.Uuid

  traceId  String  @db.VarChar(100)
  tenantId String? @db.Uuid

  connectorId String? @db.Uuid

  operation String                  @db.VarChar(255)
  direction IntegrationLogDirection

  startedAt  DateTime
  finishedAt DateTime?
  duration   Int?

  status    IntegrationLogStatus
  errorCode String?              @db.VarChar(100)

  attempt Int @default(1)

  createdAt DateTime @default(now())

  connector Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([connectorId, status])
  @@index([errorCode])
  @@index([startedAt])
  @@map("integration_logs")
}

/**
 * ==================================================================================================================
 * DEPLOYMENT MODELS
 * ==================================================================================================================
 */

enum ReleaseStatus {
  DRAFT
  ASSEMBLING
  VALIDATING
  READY
  APPROVED
  RELEASED
  SUPERSEDED
  ARCHIVED
}

model Release {
  id String @id @default(uuid()) @db.Uuid

  code    String @db.VarChar(100)
  version String @db.VarChar(50)

  applicationId        String @db.Uuid
  applicationVersionId String @db.Uuid
  snapshotId           String @db.Uuid

  artifactRefs         Json
  contractVersions     Json
  configurationVersion String @db.VarChar(50)

  status ReleaseStatus @default(DRAFT)

  createdBy String   @db.VarChar(100)
  createdAt DateTime @default(now())
  tenantId  String?  @db.Uuid

  approvedAt                     DateTime?
  releasedAt                     DateTime?
  currentEnvironmentDeployments  EnvironmentDeployment[] @relation("CurrentRelease")
  previousEnvironmentDeployments EnvironmentDeployment[] @relation("PreviousRelease")

  rollbacksFrom Rollback[]          @relation("RollbackFromRelease")
  rollbacksTo   Rollback[]          @relation("RollbackToRelease")
  history       DeploymentHistory[]

  application Application @relation(fields: [applicationId], references: [id])

  applicationVersion ApplicationVersion @relation(fields: [applicationVersionId], references: [id])

  snapshot Snapshot @relation(fields: [snapshotId], references: [id])

  deployments Deployment[]

  @@unique([tenantId, code, version])
  @@index([tenantId])
  @@index([applicationId])
  @@index([applicationVersionId])
  @@index([snapshotId])
  @@index([status])
  @@index([createdAt])
  @@map("releases")
}

enum DeploymentStatus {
  PENDING
  RUNNING
  VERIFYING
  SUCCEEDED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum DeploymentStrategy {
  STANDARD
  ROLLING
  BLUE_GREEN
  CANARY
}

model Deployment {
  id String @id @default(uuid()) @db.Uuid

  releaseId     String @db.Uuid
  environmentId String @db.Uuid
  tenantId      String? @db.Uuid

  status   DeploymentStatus   @default(PENDING)
  strategy DeploymentStrategy @default(STANDARD)

  idempotencyKey String? @unique @db.VarChar(150)

  startedBy  String    @db.VarChar(100)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  healthStatus String? @db.VarChar(50)
  traceId      String? @db.VarChar(100)

  release Release @relation(fields: [releaseId], references: [id])

  environment           Environment            @relation(fields: [environmentId], references: [id])
  environmentDeployment EnvironmentDeployment?

  gates     DeploymentGate[]
  rollbacks Rollback[]
  history   DeploymentHistory[]

  @@index([tenantId])
  @@index([releaseId])
  @@index([environmentId])
  @@index([status])
  @@index([strategy])
  @@index([traceId])
  @@index([startedAt])
  @@map("deployments")
}

enum EnvironmentDeploymentStatus {
  ACTIVE
  DEPLOYING
  FAILED
  ROLLED_BACK
  DRIFTED
  LOCKED
}

model EnvironmentDeployment {
  id String @id @default(uuid()) @db.Uuid

  environmentId String @db.Uuid
  applicationId String @db.Uuid
  tenantId      String? @db.Uuid

  currentReleaseId  String? @db.Uuid
  previousReleaseId String? @db.Uuid
  deploymentId      String? @unique @db.Uuid

  deployedAt   DateTime?
  healthStatus String?   @db.VarChar(50)

  status EnvironmentDeploymentStatus @default(ACTIVE)

  environment Environment @relation(fields: [environmentId], references: [id])

  application Application @relation(fields: [applicationId], references: [id])

  deployment Deployment? @relation(fields: [deploymentId], references: [id])

  currentRelease Release? @relation("CurrentRelease", fields: [currentReleaseId], references: [id])

  previousRelease Release? @relation("PreviousRelease", fields: [previousReleaseId], references: [id])

  @@unique([environmentId, applicationId])
  @@index([tenantId])
  @@index([environmentId])
  @@index([applicationId])
  @@index([currentReleaseId])
  @@index([status])
  @@map("environment_deployments")
}

enum DeploymentGateType {
  CONTRACT_COMPATIBILITY
  SNAPSHOT_VALID
  CONFIGURATION_VALID
  BUILD_AVAILABLE
  TESTS_PASS
  SECURITY_CHECK
  ENVIRONMENT_READY
  HEALTH_PRECHECK
  MANUAL_APPROVAL
  CUSTOM_REGISTERED_GATE
}

enum DeploymentGateResult {
  PASSED
  FAILED
  WARNING
  SKIPPED
  NOT_APPLICABLE
}

model DeploymentGate {
  id String @id @default(uuid()) @db.Uuid

  deploymentId String @db.Uuid

  type DeploymentGateType
  name String             @db.VarChar(150)

  result DeploymentGateResult @default(NOT_APPLICABLE)

  required Boolean @default(true)
  message  String? @db.Text

  executedBy String?   @db.VarChar(100)
  executedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([type])
  @@index([result])
  @@index([required])
  @@map("deployment_gates")
}

enum RollbackType {
  MANUAL_ROLLBACK
  AUTOMATIC_ROLLBACK
  REDEPLOY_PREVIOUS
}

enum RollbackStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Rollback {
  id String @id @default(uuid()) @db.Uuid

  deploymentId  String @db.Uuid
  fromReleaseId String @db.Uuid
  toReleaseId   String @db.Uuid

  type   RollbackType
  reason String       @db.Text

  status RollbackStatus @default(PENDING)

  startedBy  String    @db.VarChar(100)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  traceId String? @db.VarChar(100)

  metadata Json?

  deployment Deployment @relation(fields: [deploymentId], references: [id])

  fromRelease Release @relation("RollbackFromRelease", fields: [fromReleaseId], references: [id])

  toRelease Release @relation("RollbackToRelease", fields: [toReleaseId], references: [id])

  @@index([deploymentId])
  @@index([fromReleaseId])
  @@index([toReleaseId])
  @@index([status])
  @@index([type])
  @@index([traceId])
  @@index([startedAt])
  @@map("rollbacks")
}

enum DeploymentHistoryAction {
  CREATED
  VALIDATING
  GATE_CHECK
  STARTED
  HEALTH_CHECK
  SUCCEEDED
  FAILED
  ROLLBACK_STARTED
  ROLLBACK_COMPLETED
  CANCELLED
}

model DeploymentHistory {
  id String @id @default(uuid()) @db.Uuid

  traceId String @db.VarChar(100)
  tenantId String? @db.Uuid

  releaseId     String? @db.Uuid
  deploymentId  String? @db.Uuid
  applicationId String? @db.Uuid
  environmentId String? @db.Uuid

  action DeploymentHistoryAction
  status String                  @db.VarChar(50)

  startedAt  DateTime?
  finishedAt DateTime?
  duration   Int?

  actor     String? @db.VarChar(100)
  errorCode String? @db.VarChar(100)

  metadata Json?

  createdAt DateTime @default(now())

  release Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([traceId])
  @@index([releaseId])
  @@index([deploymentId])
  @@index([applicationId, environmentId, createdAt])
  @@index([action])
  @@index([status])
  @@map("deployment_history")
}

// =============================================================================
// ERP ADAPTER PLATFORM MODELS (merged from new erp-adapter-platform/backend)
// =============================================================================

// Table principale des ERP enregistrÃ©s
model ERPRegistry {
  id             String    @id @default(uuid())
  tenantId       String    @db.Uuid
  code           String    @unique
  nom            String
  type           String
  url            String
  status         String    @default("inactive")
  capabilities   Json?
  healthStatus   String    @default("unknown") @map("health_status")
  lastConnection DateTime? @map("last_connection")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  entityMappings EntityMapping[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@unique([tenantId, code])
  @@map("erp_registry")
}

// Table des adaptateurs ERP disponibles
model AdapterRegistry {
  id           String   @id @default(uuid())
  adapterId    String   @unique @map("adapter_id")
  nom          String
  version      String
  erpFamily    String   @map("erp_family")
  capabilities Json?
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("adapter_registry")
}

// Table des correspondances d'entitÃ©s
model EntityMapping {
  id            String   @id @default(uuid())
  tenantId      String   @db.Uuid
  erpId         String   @map("erp_id")
  entity        String
  erpEntity     String   @map("erp_entity")
  fieldMappings Json     @map("field_mappings")
  status        String   @default("active")
  version       String   @default("1.0")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  erp ERPRegistry @relation(fields: [erpId], references: [id], onDelete: Cascade)

  @@unique([tenantId, erpId, entity])
  @@index([tenantId])
  @@index([erpId])
  @@map("entity_mapping")
}

// ============ IAM / AUTH (merged from new erp-adapter-platform/backend) ============

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
  ARCHIVED
}

// NOTE: Renamed from CredentialType to avoid conflict with existing CredentialType enum
enum IamCredentialType {
  PASSWORD
  PASSKEY
  API_KEY
  EXTERNAL
  RECOVERY
}

// NOTE: Renamed from CredentialStatus to avoid conflict with existing CredentialStatus enum
enum IamCredentialStatus {
  ACTIVE
  DISABLED
  REVOKED
  EXPIRED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
  REUSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// NOTE: Renamed from Environment to avoid conflict with existing Environment model
enum IamEnvironment {
  DEVELOPMENT
  TEST
  STAGING
  PRODUCTION
}

enum DeviceTrustLevel {
  UNKNOWN
  UNTRUSTED
  TRUSTED
  PRIVILEGED
}

model IamUser {
  id                  String     @id @default(uuid())
  username            String     @unique
  primaryEmail        String     @unique
  phone               String?
  firstName           String?
  lastName            String?
  displayName         String?
  avatarRef           String?
  locale              String?
  timezone            String?
  status              UserStatus @default(PENDING)
  isAdmin             Boolean    @default(false)
  defaultTenantId     String? @db.Uuid
  metadata            Json?
  statusChangedAt     DateTime?
  statusChangedBy     String?
  statusChangedReason String?
  passwordResetToken   String?
  passwordResetExpiresAt DateTime?
   createdAt           DateTime   @default(now())
   updatedAt           DateTime   @updatedAt
   createdBy           String?
   updatedBy           String?
   archivedAt          DateTime?
   version             Int        @default(1)

   credentials     IamCredential[]
   passwordHistory IamPasswordHistory[]
   devices         IamDevice[]
   sessions        IamSession[]
   mfaMethods      MfaMethod[]
   recoveryCodes   RecoveryCode[]
   identities      UserIdentity[]
   memberships     Membership[]
   groupMembers    GroupMember[]
   roleAssignments RoleAssignment[]
   defaultTenant   Tenant?    @relation("DefaultTenantUsers", fields: [defaultTenantId], references: [id])

   @@index([defaultTenantId])
   @@map("iam_user")
}

model IamCredential {
  id           String           @id @default(uuid())
  userId       String
  type         IamCredentialType
  status       IamCredentialStatus @default(ACTIVE)
  secretHash   String?
  secretRef    String?
  identifier   String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  lastUsedAt   DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())
  createdBy    String?
  updatedAt    DateTime         @updatedAt

  user IamUser @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@index([type])
   @@index([status])
   @@map("iam_credential")
}

model IamPasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user IamUser @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@index([createdAt])
   @@map("iam_password_history")
}

model IamDevice {
  id              String           @id @default(uuid())
  userId          String
  fingerprintHash String?
  name            String?
  deviceType      String?
  trustLevel      DeviceTrustLevel @default(UNKNOWN)
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  trustedAt       DateTime?
  trustedBy       String?
  revokedAt       DateTime?
  revokedBy       String?
  revokeReason    String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     IamUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions IamSession[]

   @@index([userId])
   @@index([trustLevel])
   @@map("iam_device")
}

model IamSession {
  id                  String        @id @default(uuid())
  userId              String
  tenantId            String? @db.Uuid
  organizationId      String?
  siteId              String?
  applicationId       String?
  environment         IamEnvironment?
  deviceId            String?
  status              SessionStatus @default(ACTIVE)
  authenticationLevel String?
  riskLevel           RiskLevel     @default(LOW)
  ipHash              String?
  userAgentHash       String?
  createdAt           DateTime      @default(now())
  lastActivityAt      DateTime      @default(now())
  idleExpiresAt       DateTime?
  expiresAt           DateTime?
  revokedAt           DateTime?
  revokedBy           String?
  revokeReason        String?
  statusChangedAt     DateTime?
  metadata            Json?

  user          IamUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        IamDevice?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens IamRefreshToken[]

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([expiresAt])
   @@index([userId, status])
   @@map("iam_session")
}

model IamRefreshToken {
  id                String      @id @default(uuid())
  sessionId         String
  tokenHash         String      @unique
  familyId          String
  status            TokenStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  expiresAt         DateTime
  rotatedAt         DateTime?
  revokedAt         DateTime?
  revokeReason      String?
  replacedByTokenId String?

  session IamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([status])
   @@index([expiresAt])
    @@map("iam_refresh_token")
}

