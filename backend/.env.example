# Techzone Cloud — Backend environment variables
# Copy this file to .env and fill with your values.
# NEVER commit the real .env file.

# ── Server ─────────────────────────────────────────────
PORT=3003
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Frontend ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://techzone:techzone_password@localhost:5432/techzonecloud
# Schemas used:
#   auth_aim        — IAM data retention (legacy)
#   erp_adapter     — ERP registry & adapter
#   business_manager — Platform / Integration / Deployment

# ── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m

# ── Security ───────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Email (SMTP, optional) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_TLS_INSECURE=false
MAIL_FROM=no-reply@techzone.cloud

# ── Dolibarr ERP adapter (optional) ───────────────────
DOLIBARR_URL=
DOLIBARR_API_KEY=
DOLIBARR_ENTITY=1
DOLIBARR_TIMEOUT=10000
DOLIBARR_RETRY_ATTEMPTS=3
DOLIBARR_RETRY_DELAY=1000

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=info
