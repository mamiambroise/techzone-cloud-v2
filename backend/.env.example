# Techzone Cloud — Backend environment variables
# Copy this file to .env and fill with your values.
# NEVER commit the real .env file.

# ── Server ─────────────────────────────────────────────
PORT=3003
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Frontend ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://techzone:techzone_password@localhost:5432/techzonecloud
# Schemas used:
#   auth_aim        — IAM data retention (legacy)
#   erp_adapter     — ERP registry & adapter
#   business_manager — Platform / Integration / Deployment

# ── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m

# ── Security ───────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Email (SMTP, optional) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_TLS_INSECURE=false
MAIL_FROM=no-reply@techzone.cloud

# ── Dolibarr ERP adapter (optional) ───────────────────
DOLIBARR_URL=
DOLIBARR_API_KEY=
DOLIBARR_ENTITY=1
DOLIBARR_TIMEOUT=10000
DOLIBARR_RETRY_ATTEMPTS=3
DOLIBARR_RETRY_DELAY=1000

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=info

# Local recipe credentials (never commit real password)
TEST_USER_USERNAME=techzonetest
TEST_USER_PASSWORD=
# Windows profiles: local loads .env + .env.local; remote loads .env.remote only
APP_ENV=local

# ERP tenant credentials (optional; configure real values only in .env.local/.env.remote)
DOLIBARR_TENANT_ID=
DOLIBARR_TECHNICAL_LOGIN=
DOLIBARR_TECHNICAL_PASSWORD=
DOLIBARR_TECHNICAL_API_KEY=
DOLIBARR_ADMIN_AUDIT_API_KEY=
ERP_CREDENTIAL_ENCRYPTION_KEY=change_me_with_a_32_byte_base64_key
ERP_DEMO_MODE=false
# Private destinations are rejected unless explicitly allowlisted for local development.
DOLIBARR_ALLOWED_PRIVATE_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# API protection and runtime cache
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
RUNTIME_CACHE_TTL_MS=30000
RUNTIME_CACHE_MAX_ENTRIES=1000

# Billing (scheduler is opt-in outside production)
BILLING_SCHEDULER_ENABLED=false
BILLING_SCHEDULER_INTERVAL_MINUTES=60
BILLING_ENTITLEMENT_CACHE_TTL_MS=30000
BILLING_GRACE_DAYS=0
BILLING_QUOTA_WARNING_THRESHOLDS=80,100
BILLING_INVOICE_NUMBER_FORMAT=TZ-{YYYY}-{SEQ}

# Optional endpoint used by local recipe scripts.
TEST_LOGIN_IDENTIFIER=
TEST_LOGIN_PASSWORD=
