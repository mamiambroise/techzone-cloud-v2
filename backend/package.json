{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node ./test/iam-e2e-runner.mjs",
    "seed:e2e:iam": "node ./test/iam-e2e-seed-runner.mjs",
    "seed": "tsx ./test/seed/cli.ts",
    "seed:test": "npm run seed -- --env=test --profile=standard",
    "seed:e2e": "npm run seed -- --env=e2e --profile=security",
    "seed:dev": "npm run seed -- --env=dev --profile=standard",
    "seed:demo": "npm run seed -- --env=demo --profile=demo",
    "seed:staging": "npm run seed -- --env=staging --profile=standard",
    "seed:cleanup": "tsx ./test/seed/cli.ts --cleanup",
    "seed:list": "tsx ./test/seed/cli.ts --list",
    "setup:test-db": "node ./test/setup-test-database.mjs",
    "prisma:test:validate": "node ./test/with-test-database.mjs validate",
    "prisma:test:generate": "node ./test/with-test-database.mjs generate",
    "prisma:test:migrate": "node ./test/with-test-database.mjs migrate deploy",
    "seed:bm": "tsx src/prisma/seed-bm.ts",
    "test:security:ui": "npm test -- --runInBand ui-builder ui-snapshot.integration pack-runtime.service.spec data-runtime.controller.spec validation.service.spec iam-permission.guard.spec"
  },
  "prisma": {
    "seed": "tsx src/prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/helmet": "^0.0.48",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.6.5",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "semver": "^7.8.5",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.0.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  }
}
