# Techzone Cloud remote profile.
# Copy to backend/.env.remote and replace every placeholder outside version control.
# The root launcher loads this file exclusively when APP_ENV=remote.

APP_ENV=remote
NODE_ENV=production
PORT=3003
CORS_ORIGIN=https://console.example.com
FRONTEND_URL=https://console.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/techzonecloud

JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_long_random_value
ACCESS_TOKEN_TTL=15m
BCRYPT_SALT_ROUNDS=12

MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_TLS_INSECURE=false

# Configure connector secrets only in the deployed secret store or this ignored file.
DOLIBARR_URL=
DOLIBARR_API_KEY=
DOLIBARR_ENTITY=1
DOLIBARR_TIMEOUT=10000
DOLIBARR_RETRY_ATTEMPTS=3
DOLIBARR_RETRY_DELAY=1000
DOLIBARR_TENANT_ID=
DOLIBARR_TECHNICAL_LOGIN=
DOLIBARR_TECHNICAL_PASSWORD=
DOLIBARR_TECHNICAL_API_KEY=
DOLIBARR_ADMIN_AUDIT_API_KEY=
ERP_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key
ERP_DEMO_MODE=false
DOLIBARR_ALLOWED_PRIVATE_ORIGINS=

IAM_API_URL=/api/iam
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
RUNTIME_CACHE_TTL_MS=30000
RUNTIME_CACHE_MAX_ENTRIES=1000
BILLING_SCHEDULER_ENABLED=false
BILLING_SCHEDULER_INTERVAL_MINUTES=60
BILLING_ENTITLEMENT_CACHE_TTL_MS=30000
BILLING_GRACE_DAYS=0
BILLING_QUOTA_WARNING_THRESHOLDS=80,100
BILLING_INVOICE_NUMBER_FORMAT=TZ-{YYYY}-{SEQ}
LOG_LEVEL=info

# Optional operational recipe account; never commit its password.
TEST_USER_USERNAME=
TEST_USER_PASSWORD=
TEST_LOGIN_IDENTIFIER=
TEST_LOGIN_PASSWORD=
