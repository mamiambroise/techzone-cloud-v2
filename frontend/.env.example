# Browser-safe configuration only. Never place passwords, API keys or ERP secrets here.
# Copy to frontend/.env.local for a local override, or frontend/.env.remote.local for APP_ENV=remote.
# The local launcher uses Vite's conventional "development" mode.
VITE_API_BASE_URL=/api
VITE_IAM_URL=/api/iam
VITE_APP_NAME=Techzone Cloud
