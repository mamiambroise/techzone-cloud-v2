# ============================================================
#   ERP ADAPTER PLATFORM - VARIABLES DE PRODUCTION
#   Copier ce fichier vers .env et remplacer les valeurs
#   (a la racine du projet, utilisees par docker-compose.prod.yml)
# ============================================================

# --- Base de donnees ---
DB_PASSWORD=change-me-db-password
DATABASE_URL=postgresql://erp_user:change-me-db-password@postgres-prod:5432/erp_adapter_db

# --- Server ---
JWT_SECRET=change-me-jwt-secret
GRAFANA_PASSWORD=change-me-grafana-password
REDIS_PASSWORD=change-me-redis-password

# --- Monitoring ---
SENTRY_DSN=

# --- Dolibarr ---
DOLIBARR_URL=https://dolibarr.techzone.com
DOLIBARR_API_KEY=change-me-dolibarr-key