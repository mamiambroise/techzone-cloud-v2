generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Table principale des ERP enregistrés
model ERPRegistry {
  id             String    @id @default(uuid())
  code           String    @unique
  nom            String
  type           String
  url            String
  status         String    @default("inactive")
  capabilities   Json?
  healthStatus   String    @default("unknown") @map("health_status")
  lastConnection DateTime? @map("last_connection")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  entityMappings EntityMapping[]

  @@map("erp_registry")
}

// Table des adaptateurs ERP disponibles
model AdapterRegistry {
  id           String   @id @default(uuid())
  adapterId    String   @unique @map("adapter_id")
  nom          String
  version      String
  erpFamily    String   @map("erp_family")
  capabilities Json?
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("adapter_registry")
}

// Table des correspondances d'entités
model EntityMapping {
  id            String   @id @default(uuid())
  erpId         String   @map("erp_id")
  entity        String
  erpEntity     String   @map("erp_entity")
  fieldMappings Json     @map("field_mappings")
  status        String   @default("active")
  version       String   @default("1.0")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  erp ERPRegistry @relation(fields: [erpId], references: [id], onDelete: Cascade)

  @@unique([erpId, entity])
  @@map("entity_mapping")
}

// ============ IAM / AUTH (porté depuis Auth_AIM, branche Lianah) ============

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
  ARCHIVED
}

enum CredentialType {
  PASSWORD
  PASSKEY
  API_KEY
  EXTERNAL
  RECOVERY
}

enum CredentialStatus {
  ACTIVE
  DISABLED
  REVOKED
  EXPIRED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
  REUSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Environment {
  DEVELOPMENT
  TEST
  STAGING
  PRODUCTION
}

enum DeviceTrustLevel {
  UNKNOWN
  UNTRUSTED
  TRUSTED
  PRIVILEGED
}

model IamUser {
  id                  String     @id @default(uuid())
  username            String     @unique
  primaryEmail        String     @unique
  phone               String?
  firstName           String?
  lastName            String?
  displayName         String?
  avatarRef           String?
  locale              String?
  timezone            String?
  status              UserStatus @default(PENDING)
  isAdmin             Boolean    @default(false)
  defaultTenantId     String?
  metadata            Json?
  statusChangedAt     DateTime?
  statusChangedBy     String?
  statusChangedReason String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  version             Int        @default(1)

  credentials     IamCredential[]
  passwordHistory IamPasswordHistory[]
  devices         IamDevice[]
  sessions        IamSession[]

  @@map("iam_user")
}

model IamCredential {
  id           String           @id @default(uuid())
  userId       String
  type         CredentialType
  status       CredentialStatus @default(ACTIVE)
  secretHash   String?
  secretRef    String?
  identifier   String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  lastUsedAt   DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())
  createdBy    String?
  updatedAt    DateTime         @updatedAt

  user IamUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("iam_credential")
}

model IamPasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user IamUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("iam_password_history")
}

model IamDevice {
  id              String           @id @default(uuid())
  userId          String
  fingerprintHash String?
  name            String?
  deviceType      String?
  trustLevel      DeviceTrustLevel @default(UNKNOWN)
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  trustedAt       DateTime?
  trustedBy       String?
  revokedAt       DateTime?
  revokedBy       String?
  revokeReason    String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     IamUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions IamSession[]

  @@index([userId])
  @@index([trustLevel])
  @@map("iam_device")
}

model IamSession {
  id                  String        @id @default(uuid())
  userId              String
  tenantId            String?
  organizationId      String?
  siteId              String?
  applicationId       String?
  environment         Environment?
  deviceId            String?
  status              SessionStatus @default(ACTIVE)
  authenticationLevel String?
  riskLevel           RiskLevel     @default(LOW)
  ipHash              String?
  userAgentHash       String?
  createdAt           DateTime      @default(now())
  lastActivityAt      DateTime      @default(now())
  idleExpiresAt       DateTime?
  expiresAt           DateTime?
  revokedAt           DateTime?
  revokedBy           String?
  revokeReason        String?
  statusChangedAt     DateTime?
  metadata            Json?

  user          IamUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        IamDevice?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens IamRefreshToken[]

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([expiresAt])
  @@index([userId, status])
  @@map("iam_session")
}

model IamRefreshToken {
  id                String      @id @default(uuid())
  sessionId         String
  tokenHash         String      @unique
  familyId          String
  status            TokenStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  expiresAt         DateTime
  rotatedAt         DateTime?
  revokedAt         DateTime?
  revokeReason      String?
  replacedByTokenId String?

  session IamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
  @@map("iam_refresh_token")
}
