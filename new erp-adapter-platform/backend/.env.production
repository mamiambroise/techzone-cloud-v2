# ========== DATABASE ==========
DATABASE_URL=postgresql://erp_user:${DB_PASSWORD}@postgres-prod:5432/erp_adapter_db

# ========== SERVER ==========
NODE_ENV=production
PORT=3000
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=7d

# ========== CORS ==========
CORS_ORIGIN=https://erp-admin.techzone.com

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ========== LOGGING ==========
LOG_LEVEL=info
LOG_FORMAT=json

# ========== MONITORING ==========
SENTRY_DSN=${SENTRY_DSN}
PROMETHEUS_ENABLED=true

# ========== DOLIBARR ==========
DOLIBARR_URL=https://dolibarr.techzone.com
DOLIBARR_API_KEY=${DOLIBARR_API_KEY}

# ========== REDIS (pour cache) ==========
REDIS_URL=redis://redis-prod:6379

# ========== QUEUE (Bull) ==========
QUEUE_REDIS_URL=redis://redis-prod:6379